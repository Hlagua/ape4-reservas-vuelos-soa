# Base de datos PostgreSQL en Supabase (botón Connect > Transaction pooler, puerto 6543)
# Reemplace [PROYECTO], [CLAVE] y [REGION] con los datos de su proyecto.
DATABASE_URL=postgresql://postgres.[PROYECTO]:[CLAVE]@aws-1-[REGION].pooler.supabase.com:6543/postgres
ZONA_HORARIA=America/Guayaquil

# Seguridad
# Clave para detener/iniciar servicios (pruebas de tolerancia a fallos); debe ser igual en Render
ADMIN_KEY=cambiar-por-una-clave-larga
JWT_SECRET=cambiar-por-una-clave-larga
JWT_HORAS=2
SERVICE_KEY=cambiar-por-una-clave-larga

# Red: 0.0.0.0 acepta conexiones de otras computadoras de la red
BIND_HOST=0.0.0.0

# Minutos que un asiento queda retenido mientras el usuario completa la reserva
RETENCION_MINUTOS=5

# Puertos de cada servicio
GATEWAY_PORT=5000
USUARIOS_PORT=5001
AUTH_PORT=5002
VUELOS_PORT=5003
RESERVAS_PORT=5004
FACTURACION_PORT=5005
